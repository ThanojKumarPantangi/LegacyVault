# Database Connection
MONGO_URI=mongodb://localhost:27017/legacyvault

# JWT Auth Secret
JWT_SECRET=your_jwt_secret_key_here

# AES-256-GCM Encryption Key (Must be 32 bytes/characters long)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Brevo (Sendinblue) API Email Configuration
BREVO_API_KEY=your_brevo_api_key_here
MAIL_FROM=no-reply@legacyvault.com
MAIL_FROM_NAME=LegacyVault
